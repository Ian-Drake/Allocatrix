{
  "name": "allocatrix",
  "version": "0.1.0",
  "description": "Model Portfolio Account Manager for Schwab brokerage accounts",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "tunnel": "pwsh -ExecutionPolicy Bypass -File scripts/tunnel.ps1",
    "tunnel:sh": "bash scripts/tunnel.sh",
    "lint": "eslint src --ext .ts,.tsx --max-warnings 0",
    "lint:fix": "eslint src --ext .ts,.tsx --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,json,md}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,json,md}\"",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:contract": "vitest run tests/contract",
    "test:coverage": "vitest run --coverage",
    "db:migrate": "node -r ts-node/register src/backend/db/runner.ts",
    "db:reset": "rm -f data/allocatrix.db && npm run db:migrate",
    "db:seed": "node -r ts-node/register scripts/seed-dashboard-data.ts",
    "schwab:cert": "node tools/generate-cert.js",
    "schwab:oauth": "npm run schwab:cert && node tools/oauth-setup.js"
  },
  "dependencies": {
    "@types/uuid": "^11.0.0",
    "express": "^4.18.0",
    "next": "^14.0.0",
    "openapi-backend": "^5.9.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-window": "^1.8.10",
    "recharts": "^2.10.0",
    "sqlite3": "^5.1.6",
    "typescript": "^5.3.0",
    "uuid": "^13.0.0",
    "zustand": "^4.4.0"
  },
  "devDependencies": {
    "@jest/globals": "^29.7.0",
    "@testing-library/jest-dom": "^6.1.0",
    "@testing-library/react": "^14.1.0",
    "@types/express": "^4.17.0",
    "@types/node": "^20.10.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@types/react-window": "^1.8.8",
    "@types/supertest": "^2.0.0",
    "@typescript-eslint/eslint-plugin": "^6.16.0",
    "@typescript-eslint/parser": "^6.16.0",
    "@vitejs/plugin-react": "^5.1.1",
    "@vitest/coverage-v8": "^1.1.0",
    "@vitest/ui": "^1.1.0",
    "eslint": "^8.55.0",
    "eslint-config-next": "^14.0.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react": "^7.33.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "happy-dom": "^20.0.10",
    "jest": "^29.7.0",
    "prettier": "^3.1.0",
    "supertest": "^6.3.0",
    "ts-node": "^10.9.0",
    "vitest": "^1.1.0"
  }
}

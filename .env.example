# Schwab OAuth Configuration
SCHWAB_CLIENT_ID=your_schwab_client_id_here
SCHWAB_CLIENT_SECRET=your_schwab_client_secret_here
SCHWAB_REDIRECT_URI=http://localhost:3000/api/auth/callback

# Encryption
ENCRYPTION_KEY=your_32_byte_hex_encryption_key_here

# Database
DATABASE_URL=sqlite:///data/allocatrix.db

# Environment
NODE_ENV=development

# API
API_BASE_URL=http://localhost:3000
API_PORT=3000

# Session
SESSION_SECRET=your_session_secret_here_make_it_long_and_random

# Logging
LOG_LEVEL=info

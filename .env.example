# Massive.com S3 Flat Files (Polygon successor)
# Copy this file to .env and fill in your credentials.

# Required
MASSIVE_ACCESS_KEY_ID=
MASSIVE_SECRET_ACCESS_KEY=

# Optional (defaults shown)
MASSIVE_S3_ENDPOINT=https://files.massive.com
MASSIVE_S3_BUCKET=flatfiles

# Local raw flat-files store (S3 key structure is mirrored under this folder)
DATA_PATH=flatfiles

# Optional: override dataset prefix/key layout assumptions
# Used by: `baytrader fetch --dataset ...`
# MASSIVE_DATASET=us_stocks_sip/minute_aggs_v1

# Massive docs often download by explicit object key, e.g.
# us_stocks_sip/trades_v1/2025/11/2025-11-05.csv.gz

# Optional: override expected flat-file format
# One of: auto, csv, csv.gz, parquet
# MASSIVE_FLATFILE_FORMAT=auto
